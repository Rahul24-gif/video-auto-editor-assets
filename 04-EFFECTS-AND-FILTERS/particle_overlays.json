      "speed_y": -0.4,
      "speed_x_drift": 0.15,
      "blur_px": 2,
      "blend_mode": "screen",
      "best_for": "Moody podcast background and aesthetic b-roll"
    },
    "celebration_confetti": {
      "type": "physics_burst",
      "count": 120,
      "colors": ["#FF1744", "#FFEA00", "#00E676", "#2979FF", "#D500F9"],
